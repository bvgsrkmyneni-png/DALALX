import { useEffect, useState } from "react";
import axios from "axios";

const API = "http://localhost:5000/api/stocks";

function AdminDashboard({ token }) {
  const [stocks, setStocks] = useState([]);
  const [search, setSearch] = useState("");
  const [form, setForm] = useState({
    symbol: "",
    company_name: "",
    current_price: ""
  });
  const [editingId, setEditingId] = useState(null);
  const [loading, setLoading] = useState(false);
  const [message, setMessage] = useState("");

  const loadStocks = async () => {
    try {
      const response = await axios.get(API);
      setStocks(response.data.stocks || []);
    } catch (error) {
      console.error("Load stocks error:", error);
      setMessage("Unable to load companies.");
    }
  };

  useEffect(() => {
    loadStocks();
  }, []);

  const resetForm = () => {
    setEditingId(null);
    setForm({
      symbol: "",
      company_name: "",
      current_price: ""
    });
  };

  const handleSubmit = async (e) => {
    e.preventDefault();

    const price = Number(form.current_price);

    if (!Number.isFinite(price) || price <= 0) {
      setMessage("Enter a valid positive stock price.");
      return;
    }

    setLoading(true);
    setMessage("");

    try {
      const config = {
        headers: {
          Authorization: `Bearer ${token}`
        }
      };

      const payload = {
        company_name: form.company_name.trim(),
        current_price: price
      };

      let response;

      if (editingId !== null) {
        response = await axios.put(
          `${API}/${editingId}`,
          payload,
          config
        );
      } else {
        response = await axios.post(
          API,
          {
            ...payload,
            symbol: form.symbol.trim().toUpperCase()
          },
          config
        );
      }

      setMessage(response.data.message);
      resetForm();
      await loadStocks();
    } catch (error) {
      setMessage(
        error.response?.data?.message ||
        "Unable to save company."
      );
    } finally {
      setLoading(false);
    }
  };

  const editCompany = (stock) => {
    setEditingId(stock.stock_id);
    setForm({
      symbol: stock.symbol,
      company_name: stock.company_name,
      current_price: String(stock.current_price)
    });
    setMessage("");
    window.scrollTo({ top: 0, behavior: "smooth" });
  };

  const filteredStocks = stocks.filter((stock) => {
    const query = search.toLowerCase();

    return (
      stock.symbol.toLowerCase().includes(query) ||
      stock.company_name.toLowerCase().includes(query)
    );
  });

  const inputStyle = {
    width: "100%",
    padding: "12px",
    borderRadius: "8px",
    border: "1px solid #94a3b8",
    marginTop: "6px",
    boxSizing: "border-box"
  };

  return (
    <div>
      <div className="page-title">
        <div>
          <div className="small-heading">ADMINISTRATION</div>
          <h1>Admin Dashboard</h1>
          <p>Add and manage companies listed on DALALX.</p>
        </div>
      </div>

      <section className="panel" style={{ padding: 24 }}>
        <h2>
          {editingId !== null
            ? "Edit Company"
            : "Add New Company"}
        </h2>

        <form
          onSubmit={handleSubmit}
          style={{
            display: "grid",
            gap: 16,
            marginTop: 20,
            maxWidth: 650
          }}
        >
          <label>
            Stock Symbol
            <input
              required
              disabled={editingId !== null}
              maxLength={20}
              style={inputStyle}
              value={form.symbol}
              onChange={(e) =>
                setForm({
                  ...form,
                  symbol: e.target.value
                })
              }
              placeholder="Example: DXTECH"
            />
          </label>

          <label>
            Company Name
            <input
              required
              style={inputStyle}
              value={form.company_name}
              onChange={(e) =>
                setForm({
                  ...form,
                  company_name: e.target.value
                })
              }
              placeholder="Example: DALALX Technologies"
            />
          </label>

          <label>
            Stock Price (₹)
            <input
              required
              type="number"
              min="0.01"
              step="0.01"
              style={inputStyle}
              value={form.current_price}
              onChange={(e) =>
                setForm({
                  ...form,
                  current_price: e.target.value
                })
              }
              placeholder="111"
            />
          </label>

          <div style={{ display: "flex", gap: 12 }}>
            <button
              type="submit"
              disabled={loading}
              style={{
                padding: "12px 24px",
                background: "#2563eb",
                color: "white",
                border: "none",
                borderRadius: 8,
                cursor: "pointer"
              }}
            >
              {loading
                ? "Saving..."
                : editingId !== null
                ? "Update Company"
                : "Add Company"}
            </button>

            {editingId !== null && (
              <button
                type="button"
                onClick={resetForm}
                style={{ padding: "12px 20px" }}
              >
                Cancel
              </button>
            )}
          </div>
        </form>

        {message && (
          <p style={{ marginTop: 16 }}>{message}</p>
        )}
      </section>

      <section
        className="panel"
        style={{ padding: 24, marginTop: 24 }}
      >
        <h2>Manage Companies ({stocks.length})</h2>

        <input
          placeholder="Search company or symbol..."
          value={search}
          onChange={(e) => setSearch(e.target.value)}
          style={{
            ...inputStyle,
            maxWidth: 400,
            marginTop: 18,
            marginBottom: 18
          }}
        />

        <div style={{ overflowX: "auto" }}>
          <table
            style={{
              width: "100%",
              borderCollapse: "collapse",
              textAlign: "left"
            }}
          >
            <thead>
              <tr>
                {[
                  "Symbol",
                  "Company",
                  "Current Price",
                  "Change",
                  "Action"
                ].map((heading) => (
                  <th
                    key={heading}
                    style={{
                      padding: 12,
                      borderBottom: "1px solid #94a3b8"
                    }}
                  >
                    {heading}
                  </th>
                ))}
              </tr>
            </thead>

            <tbody>
              {filteredStocks.map((stock) => (
                <tr key={stock.stock_id}>
                  <td style={{ padding: 12 }}>
                    <strong>{stock.symbol}</strong>
                  </td>

                  <td style={{ padding: 12 }}>
                    {stock.company_name}
                  </td>

                  <td style={{ padding: 12 }}>
                    ₹{Number(stock.current_price).toFixed(2)}
                  </td>

                  <td style={{ padding: 12 }}>
                    {Number(stock.change_percent || 0).toFixed(2)}%
                  </td>

                  <td style={{ padding: 12 }}>
                    <button
                      onClick={() => editCompany(stock)}
                      style={{
                        padding: "8px 16px",
                        background: "#2563eb",
                        color: "white",
                        border: "none",
                        borderRadius: 6,
                        cursor: "pointer"
                      }}
                    >
                      Edit
                    </button>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>

          {filteredStocks.length === 0 && (
            <p>No companies found.</p>
          )}
        </div>
      </section>
    </div>
  );
}

export default AdminDashboard;
